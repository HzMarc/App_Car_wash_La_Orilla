<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <View android:id="@+id/employee_history_handle" android:layout_width="32dp" android:layout_height="4dp"
        android:layout_marginTop="12dp" android:background="@color/line" android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/employee_history_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp"
        android:text="@string/empleados_history_title" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/employee_history_handle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/employee_history_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="8dp" android:textAppearance="@style/Cierre.Caption" android:maxLines="2" android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/employee_history_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/employee_history_name" app:layout_constraintBottom_toTopOf="@id/employee_history_total_label"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/employee_history_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="24dp" android:paddingBottom="12dp"
            android:clipToPadding="false" android:overScrollMode="never" />
        <TextView android:id="@+id/employee_history_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="@string/empleados_history_empty" android:textAppearance="@style/Cierre.Caption" />
    </FrameLayout>
    <TextView android:id="@+id/employee_history_total_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:text="@string/empleados_history_total" android:textAppearance="@style/Cierre.Label"
        app:layout_constraintBottom_toTopOf="@id/employee_history_total" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/employee_history_total" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="12dp" android:textAppearance="@style/Cierre.Figure"
        app:layout_constraintBottom_toTopOf="@id/employee_history_close" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/employee_history_close"
        android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="16dp"
        android:text="@string/empleados_history_close" android:textColor="@color/bg" android:backgroundTint="@color/ink" app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
