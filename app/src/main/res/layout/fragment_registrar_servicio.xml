<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar servicio"
            android:textAppearance="@style/Orilla.ScreenTitle" />

        <TextView android:id="@+id/registrar_empleado"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textAppearance="@style/Cierre.Label" />

        <LinearLayout android:id="@+id/registrar_aviso_caja" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
            <TextView android:id="@+id/registrar_aviso_texto" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/caja_falta_apertura" android:textAppearance="@style/Cierre.Label" />
            <com.google.android.material.button.MaterialButton android:id="@+id/registrar_ir_inicio"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/caja_ir_inicio" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/registrar_vehiculo_tabs"
            style="@style/Orilla.SectionTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalogo_car" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalogo_motorcycle" />
        </com.google.android.material.tabs.TabLayout>
        <!-- Etiqueta: Servicio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Servicio"
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp" />

        <!-- Contenedor de Lista de Servicios -->
        <LinearLayout
            android:id="@+id/contenedorServicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Encargado del vehículo (Cliente)"
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp" />

        <!-- Campo de texto para ingresar cliente / encargado -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCliente"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/app_black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:hint="Nombre o datos del cliente"
                android:inputType="textCapWords"
                android:textColor="@color/app_black"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Etiqueta: Método de pago -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Método de pago"
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp" />

        <!-- Selector de Método de Pago -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsMetodoPago"
            style="@style/Orilla.SectionTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Efectivo" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transferencia" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Contenedor para detalles de pago en Efectivo -->
        <LinearLayout
            android:id="@+id/contenedorEfectivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Campo para ingresar con cuánto paga el cliente -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutMontoRecibido"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/app_black"
                    app:prefixText="$">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoMontoRecibido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:hint="Efectivo recibido"
                        android:inputType="numberDecimal"
                        android:textColor="@color/app_black"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Cuadro para mostrar el cambio -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/app_card_bg"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/app_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Cambio"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textoCambioCalculado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:text="$0.00"
                            android:textColor="@color/app_black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Cuadro de Precio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/app_yellow"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/textoPrecioTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:padding="22dp"
                android:text="Precio $5.00"
                android:textColor="@color/app_black"
                android:textSize="26sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Guardar Atención -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardarAtencion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/app_black"
            android:fontFamily="sans-serif-condensed"
            android:text="Guardar atención"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>