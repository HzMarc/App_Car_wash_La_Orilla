<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Contenido Principal Desplazable -->
    <LinearLayout
        android:id="@+id/contenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/tarjetaPanelInferior"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Servicios registrados"
            android:textColor="@color/app_black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Barra de Búsqueda / SearchView -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/app_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/app_border"
            app:strokeWidth="1.5dp">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/vistaBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="Buscar por empleado o servicio" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Contenedor Dinámico para Lista de Servicios -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/contenedorListaServicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Panel Inferior (Bottom Sheet / Detalle) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaPanelInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/app_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/app_border"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="Detalle de la atención"
                android:textColor="@color/app_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoDetalleAtencion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Carro · Lavado completo · Carlos Mendoza · $10.00"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <!-- Botón Corregir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCorregir"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Corregir (motivo)"
                android:textColor="@color/app_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/app_black"
                app:strokeWidth="1.5dp" />

            <!-- Botón Anular -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAnular"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Anular (motivo)"
                android:textColor="@color/app_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/app_black"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>