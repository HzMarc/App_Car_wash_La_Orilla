<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <TextView
        android:id="@+id/catalogo_toolbar" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="24dp"
        android:text="@string/catalogo_title" android:textAppearance="@style/Orilla.ScreenTitle"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/catalogo_list" android:layout_width="0dp" android:layout_height="0dp"
        android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="12dp"
        android:clipToPadding="false" android:overScrollMode="never" tools:listitem="@layout/item_catalogo_servicio"
        app:layout_constraintTop_toBottomOf="@id/catalogo_toolbar" app:layout_constraintBottom_toTopOf="@id/catalogo_add"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/catalogo_empty" android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="vertical" android:gravity="center" android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/catalogo_toolbar" app:layout_constraintBottom_toTopOf="@id/catalogo_add"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/catalogo_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/catalogo_empty" android:textAppearance="@style/Cierre.Label" />
        <TextView android:id="@+id/catalogo_empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:text="@string/catalogo_empty_hint" android:textAppearance="@style/Cierre.Caption" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton style="@style/Orilla.Button.Add"
        android:id="@+id/catalogo_add" android:layout_width="0dp" android:layout_height="52dp"
        android:layout_margin="16dp" android:text="@string/catalogo_add"
        app:icon="@drawable/ic_add_service" app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
